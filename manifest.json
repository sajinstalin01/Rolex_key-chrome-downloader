{
  "manifest_version": 3,
  "name": "Rolex_key Chrome Extension Downloader",
  "version": "2.3.0",
  "description": "Download, inspect, compare, audit, and manage Chrome extension packages with premium icons, themes, visual setup guides, and update notifications.",
  "minimum_chrome_version": "110",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://clients2.google.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/*",
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dl.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "Rolex_key Downloader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
